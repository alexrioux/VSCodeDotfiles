{
    "workbench.colorTheme": "monochrome",
    "workbench.colorCustomizations": {
        "editor.foreground": "#535353",
        "editor.background": "#161616"
    },
    "editor.fontFamily": "Terminess Nerd Font",
    "editor.fontSize": 17,
    "editor.semanticHighlighting.enabled": false,
    "editor.bracketPairColorization.enabled": false,
    "editor.semanticTokenColorCustomizations": {
        "enabled": true,
        "rules": {
            "variable": "#424242",
            "parameter": "#424242",
            "type": "#636363", // STRUCT
            "macro": "#33804c"
        }
    },
    "editor.tokenColorCustomizations": {
        "textMateRules": [
            {
                // DEFAULT
                "scope": ["source"],
                "settings": {
                    "foreground": "#ff0000"
                }
            },
            {
                // CONTROL KEYWORDS & BLOCKS
                "scope": ["keyword.control", "punctuation.section.block"],
                "settings": {
                    "foreground": "#00ff55"
                }
            },
            {
                // TYPES | NUMBERS
                "scope": ["storage", "constant.numeric"],
                "settings": {
                    "foreground": "#636363"
                }
            },
            {
                // OPERATORS
                "scope": ["keyword.operator"],
                "settings": {
                    "foreground": "#ffffff"
                }
            },
            {
                // COMMENTS
                "scope": ["comment", "punctuation.definition.comment", "keyword.control.directive"],
                "settings": {
                    "foreground": "#333333"
                }
            },
            {
                // FUNCTIONS
                "scope": ["punctuation.separator.delimiter", "entity.name.function", "punctuation.section.arguments"],
                "settings": {
                    "foreground": "#b9b9b9"
                }
            },
            {
                // STRINGS
                "scope": ["string.quoted"],
                "settings": {
                    "foreground": "#5e5e5e"
                }
            },
        ]
    },
    "terminal.integrated.profiles.windows": {
        "PowerShell": {
            "source": "PowerShell",
            "icon": "terminal-powershell"
        },
        "Command Prompt": {
            "path": "C:\\WINDOWS\\System32\\cmd.exe",
            "args": []
        },
        "Git Bash": {
            "source": "Git Bash",
            "icon": "terminal-git-bash"
        },
        "x64Dev": {
            "path": "C:\\WINDOWS\\System32\\cmd.exe",
            "args": []
        }
    },
    "terminal.integrated.defaultProfile.windows": "Command Prompt",
}